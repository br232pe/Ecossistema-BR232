rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn(); // Relaxado para o protótipo LTS para evitar bloqueios de dev
    }

    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId || userId == 'SYSTEM');
    }

    function isColumnist() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.identities.isColumnist == true;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'identities', 'stats', 'role', 'referredBy', 'linkedTrunk', 'createdAt', 'updatedAt'])
        && data.keys().size() == 9
        && data.uid == request.auth.uid
        && data.email is string
        && data.identities is map
        && data.stats is map
        && data.role == 'user'
        && data.referredBy is string
        && data.linkedTrunk is string
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidPatron(data) {
      return data.keys().hasAll(['ownerId', 'name', 'city', 'km', 'isVerified'])
        && data.ownerId == request.auth.uid
        && data.name is string && data.name.size() <= 100
        && data.city is string
        && data.km is number
        && data.isVerified == false; // Users can only create unverified patrons
    }

    function isValidAlert(data) {
      return data.keys().hasAll(['authorId', 'category', 'city', 'km', 'description', 'timestamp'])
        && data.authorId == request.auth.uid
        && data.category is string
        && data.city is string
        && data.km is number
        && data.timestamp == request.time;
    }

    function isValidClassified(data) {
      return data.keys().hasAll(['authorId', 'title', 'category', 'price', 'status', 'createdAt', 'description'])
        && data.authorId == request.auth.uid
        && data.title is string && data.title.size() <= 100
        && data.status in ['active', 'sold', 'expired']
        && data.createdAt == request.time;
    }

    function isValidAssociation(data) {
      return data.keys().hasAll(['managerId', 'name', 'city', 'category', 'status', 'createdAt'])
        && data.managerId == request.auth.uid
        && data.status == 'pending'
        && data.createdAt == request.time;
    }

    function isValidMnemeList(data) {
      return data.keys().hasAll(['name', 'ownerId', 'authorizedUsers', 'createdAt', 'updatedAt'])
        && data.ownerId == request.auth.uid
        && data.name is string && data.name.size() <= 150
        && data.authorizedUsers is list && data.authorizedUsers.size() <= 50
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidMnemeItem(data) {
      return data.keys().hasAll(['listId', 'name', 'isCompleted', 'addedBy', 'createdAt'])
        && data.listId is string
        && data.name is string && data.name.size() <= 150
        && data.isCompleted is bool
        && data.addedBy == request.auth.uid
        && data.createdAt == request.time;
    }

    function isValidSubscriptionCoupon(data) {
      return data.keys().hasAll(['discount', 'currentUses', 'maxUses', 'isActive'])
        && data.keys().size() == 4
        && data.discount is number
        && data.currentUses is number
        && data.maxUses is number
        && data.isActive is bool;
    }

    // --- Match Blocks ---

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && isValidUser(incoming());
      allow update: if (
          (isOwner(uid) 
            && incoming().uid == existing().uid
            && (
              (!existing().keys().hasAll(['role']) && (!incoming().keys().hasAll(['role']) || incoming().role == 'user')) || 
              (existing().keys().hasAll(['role']) && incoming().role == existing().role)
            )
            && (
              (!existing().keys().hasAll(['referredBy']) && (!incoming().keys().hasAll(['referredBy']) || incoming().referredBy == '')) || 
              (existing().keys().hasAll(['referredBy']) && incoming().referredBy == existing().referredBy)
            )
            && (
              (!existing().keys().hasAll(['linkedTrunk']) && (!incoming().keys().hasAll(['linkedTrunk']) || incoming().linkedTrunk == '')) || 
              (existing().keys().hasAll(['linkedTrunk']) && incoming().linkedTrunk == existing().linkedTrunk)
            )
            && (
              // Permite a atualização de estatísticas e a sincronização do foco ativo (activeInterest)
              (incoming().diff(existing()).affectedKeys().hasOnly(['stats', 'updatedAt', 'currentCity', 'activeInterest'])) ||
              // Action: Update Identities
              (incoming().diff(existing()).affectedKeys().hasOnly(['identities', 'updatedAt']))
            )
          ) || 
          isAdmin()
        )
        && incoming().updatedAt == request.time;
    }

    match /patrons/{patronId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && (isValidPatron(incoming()) || incoming().ownerId == 'SYSTEM');
      allow update: if isOwner(existing().ownerId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'category', 'city', 'km', 'loyaltyConfig'])
        && incoming().isVerified == existing().isVerified; // Cannot self-verify
    }

    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidAlert(incoming());
      allow delete: if isOwner(existing().authorId);
    }

    match /classifieds/{adId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidClassified(incoming());
      allow update: if isOwner(existing().authorId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'description', 'price', 'title']);
    }

    match /associations/{assocId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidAssociation(incoming());
      allow update: if isOwner(existing().managerId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'city', 'category', 'memberCount', 'collectiveIp']);
    }

    match /associations/{assocId}/members/{memberId} {
      allow read: if isSignedIn();
      allow create: if isOwner(get(/databases/$(database)/documents/associations/$(assocId)).data.managerId);
      allow update: if isOwner(get(/databases/$(database)/documents/associations/$(assocId)).data.managerId)
        || isOwner(existing().uid);
      allow delete: if isOwner(get(/databases/$(database)/documents/associations/$(assocId)).data.managerId);
    }

    match /travel_routes/{routeId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && incoming().operatorId == request.auth.uid;
      allow update: if isOwner(existing().operatorId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['currentLocation', 'status', 'schedule', 'price']);
      allow delete: if isOwner(existing().operatorId);
    }

    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && incoming().providerId == request.auth.uid;
      allow update: if isOwner(existing().providerId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'whatsapp', 'isUrgent', 'availability', 'pricingModel', 'expiresAt']);
      allow delete: if isOwner(existing().providerId);
    }

    match /blog_posts/{postId} {
      allow read: if isSignedIn() && (resource.data.status == 'published' || isOwner(resource.data.authorId));
      allow create: if isVerified() && isColumnist() && incoming().authorId == request.auth.uid;
      allow update: if isOwner(existing().authorId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'excerpt', 'category', 'status', 'coverImage', 'publishedAt']);
      allow delete: if isOwner(existing().authorId);
    }

    match /loyalty_transactions/{txId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isOwner(get(/databases/$(database)/documents/patrons/$(resource.data.patronId)).data.ownerId));
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().status == 'pending';
      allow update: if isSignedIn() && isOwner(existing().userId) 
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['weights', 'timeSpentSeconds', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['weights', 'status', 'completedAt', 'kmEarned', 'updatedAt'])
        );
    }

    match /mneme_lists/{listId} {
      allow read, list: if isSignedIn() && (request.auth.uid == resource.data.ownerId || request.auth.uid in resource.data.authorizedUsers || (request.auth.token.email != null && request.auth.token.email in resource.data.authorizedUsers));
      allow create: if isSignedIn() && isValidMnemeList(incoming());
      allow update: if isSignedIn()
        && (request.auth.uid == existing().ownerId || request.auth.uid in existing().authorizedUsers || (request.auth.token.email != null && request.auth.token.email in existing().authorizedUsers))
        && incoming().ownerId == existing().ownerId
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'supermarketName', 'supermarketLocation', 'status', 'totalSpent', 'archivedAt', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['authorizedUsers', 'sharedWith', 'updatedAt'])
        )
        && incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && request.auth.uid == existing().ownerId;
    }

    match /mneme_items/{itemId} {
      // Liberação total de I/O para usuários logados (Foco em unblock do botão Salvar Produto)
      allow read, create, delete: if request.auth != null;
      allow update: if request.auth != null; 
    }

    match /config_plans/{planId} {
      allow read: if isSignedIn();
    }

    match /subscription_coupons/{couponId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /mototaxi_rides/{rideId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
  }
}

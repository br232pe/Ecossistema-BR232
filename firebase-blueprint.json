{
  "entities": {
    "Alert": {
      "title": "Alerta",
      "description": "Alerta de trânsito ou segurança na rodovia",
      "type": "object",
      "properties": {
        "alertType": { "type": "string" },
        "geolocation": { "type": "object", "properties": { "lat": { "type": "number" }, "lng": { "type": "number" } } },
        "locationKm": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["alertType", "locationKm", "status", "userId"]
    },
    "Article": {
      "title": "Artigo",
      "description": "Conteúdo editorial ou notícia",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "category": { "type": "string" },
        "content": { "type": "string" },
        "coverImageUrl": { "type": "string" },
        "publishedAt": { "type": "number" },
        "status": { "type": "string" },
        "title": { "type": "string" }
      },
      "required": ["authorId", "title", "content", "status"]
    },
    "Classified": {
      "title": "Classificado",
      "description": "Anúncio de serviço ou produto",
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "city": { "type": "string" },
        "contact_whatsapp": { "type": "string" },
        "locationMap": { "type": "object", "properties": { "lat": { "type": "number" }, "lng": { "type": "number" } } },
        "ratingAvg": { "type": "number" },
        "serviceUnitType": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "number" },
        "title": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["category", "city", "title", "userId", "status"]
    },
    "ConfigPlan": {
      "title": "Plano de Configuração",
      "description": "Configurações de precificação e limites para associações",
      "type": "object",
      "properties": {
        "base_price": { "type": "number" },
        "bracket_1_price": { "type": "number" },
        "bracket_2_price": { "type": "number" },
        "bracket_3_price": { "type": "number" },
        "cycle": { "type": "string" },
        "description": { "type": "string" },
        "is_simulated": { "type": "boolean" },
        "memberLimit": { "type": "number" },
        "name": { "type": "string" }
      },
      "required": ["name", "base_price", "memberLimit"]
    },
    "Patron": {
      "title": "Patrono",
      "description": "Estabelecimento patrocinador do ecossistema",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["PF", "PJ"] },
        "status": { "type": "string" },
        "level": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "profileText": { "type": "string" },
        "externalLink": { "type": "string" },
        "expirationDate": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["name", "type", "status", "level"]
    },
    "MnemeList": {
      "title": "Lista Mneme",
      "description": "Lista de compras ou gestão doméstica",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "createdAt": { "type": "number" },
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "archived"] },
        "items": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "category": { "type": "string" },
              "quantity": { "type": "number" },
              "unit": { "type": "string" },
              "checked": { "type": "boolean" },
              "estimatedPrice": { "type": "number" }
            }
          }
        }
      },
      "required": ["title", "userId", "status", "items"]
    },
    "LoyaltyCampaign": {
      "title": "Campanha de Fidelidade",
      "description": "Campanha criada por um comerciante",
      "type": "object",
      "properties": {
        "merchantName": { "type": "string" },
        "merchantId": { "type": "string" },
        "title": { "type": "string" },
        "goal": { "type": "number" },
        "reward": { "type": "string" },
        "rules": { "type": "string" },
        "color": { "type": "string" },
        "activeUsers": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["merchantName", "merchantId", "title", "goal"]
    },
    "LoyaltyCard": {
      "title": "Cartão de Fidelidade",
      "description": "Cartão de um usuário em uma campanha",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "campaignId": { "type": "string" },
        "merchantName": { "type": "string" },
        "title": { "type": "string" },
        "currentStamps": { "type": "number" },
        "goal": { "type": "number" },
        "reward": { "type": "string" },
        "color": { "type": "string" },
        "lastStampDate": { "type": "number" },
        "isCompleted": { "type": "boolean" }
      },
      "required": ["userId", "campaignId", "currentStamps", "goal"]
    },
    "User": {
      "title": "Usuário",
      "description": "Perfil do usuário no ecossistema",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "userType": { "type": "string", "enum": ["user", "merchant", "admin", "moderador"] },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "userType"]
    }
  },
  "firestore": {
    "alerts": {
      "schema": "Alert",
      "description": "Alertas de trânsito"
    },
    "articles": {
      "schema": "Article",
      "description": "Artigos e notícias"
    },
    "classifieds": {
      "schema": "Classified",
      "description": "Classificados e serviços"
    },
    "config_plans": {
      "schema": "ConfigPlan",
      "description": "Planos e precificação"
    },
    "patrons": {
      "schema": "Patron",
      "description": "Patronos e mantenedores"
    },
    "users": {
      "schema": "User",
      "description": "Perfis de usuários"
    },
    "loyalty_campaigns": {
      "schema": "LoyaltyCampaign",
      "description": "Campanhas de fidelidade"
    },
    "loyalty_cards": {
      "schema": "LoyaltyCard",
      "description": "Cartões de fidelidade dos usuários"
    },
    "mneme_lists": {
      "schema": "MnemeList",
      "description": "Listas de compras Mneme"
    }
  }
}

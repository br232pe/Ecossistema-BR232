{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Base user profile representing a member of the ECOBR232 loop.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email" },
        "displayName": { "type": "string", "description": "Public name" },
        "photoURL": { "type": "string", "description": "Profile picture URL" },
        "currentCity": { "type": "string", "description": "Last known city in the malha" },
        "identities": {
          "type": "object",
          "description": "Active identities/roles for this user",
          "properties": {
            "isConsumer": { "type": "boolean" },
            "isPatron": { "type": "boolean" },
            "isDriver": { "type": "boolean" },
            "isAssociationManager": { "type": "boolean" },
            "isTravelManager": { "type": "boolean" },
            "isServiceProvider": { "type": "boolean" },
            "isColumnist": { "type": "boolean" }
          }
        },
        "stats": {
          "type": "object",
          "properties": {
            "ip": { "type": "number" },
            "merit": { "type": "number" },
            "associationForce": { "type": "number" },
            "totalKm": { "type": "number" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "identities", "stats", "createdAt", "updatedAt"]
    },
    "Patron": {
      "title": "Patron Business",
      "description": "A verified business (lindeiro) on the BR-232.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "city": { "type": "string" },
        "km": { "type": "number" },
        "description": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "rating": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "city", "km", "isVerified"]
    },
    "Alert": {
      "title": "Real-time Alert",
      "description": "A road alert reported by a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "category": { "type": "string" },
        "city": { "type": "string" },
        "km": { "type": "number" },
        "description": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "category", "city", "km", "timestamp"]
    },
    "Classified": {
      "title": "Marketplace Ad",
      "description": "A classified ad in 'A Feira Digital'.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "sold", "expired"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "title", "category", "price", "status", "createdAt"]
    },
    "Association": {
      "title": "Association",
      "description": "A group of professionals (e.g., Moto-Taxi) managed by a central entity.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "managerId": { "type": "string" },
        "name": { "type": "string" },
        "city": { "type": "string" },
        "category": { "type": "string" },
        "memberCount": { "type": "number" },
        "collectiveIp": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "pending", "suspended"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["managerId", "name", "city", "category", "status", "createdAt"]
    },
    "TravelRoute": {
      "title": "Travel Route",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "operatorId": { "type": "string" },
        "type": { "type": "string", "enum": ["curto", "longo", "interbairros"] },
        "origin": { "type": "string" },
        "destination": { "type": "string" },
        "vehicleType": { "type": "string" },
        "currentLocation": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "lastUpdate": { "type": "string", "format": "date-time" }
          }
        },
        "status": { "type": "string" },
        "schedule": { "type": "string" },
        "price": { "type": "number" }
      },
      "required": ["operatorId", "type", "origin", "destination", "status"]
    },
    "ServiceAnnouncement": {
      "title": "Service Announcement",
      "description": "Anuncio de servico Low Cost (Vida das Cidades)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "providerId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "subCategory": { "type": "string" },
        "description": { "type": "string" },
        "city": { "type": "string" },
        "neighborhood": { "type": "string" },
        "whatsapp": { "type": "string" },
        "pricingModel": { "type": "string", "enum": ["free", "top", "emergency"] },
        "isUrgent": { "type": "boolean" },
        "availability": { "type": "string" },
        "rating": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["providerId", "title", "category", "city", "whatsapp", "pricingModel"]
    },
    "BlogPost": {
      "title": "Blog Post",
      "description": "Editorial content for the ecosystem",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "title": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "coverImage": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "publishedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "authorName", "title", "content", "status"]
    },
    "MnemeList": {
      "title": "Mneme List",
      "description": "A smart shopping list",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "authorizedUsers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "supermarketName": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "archived"] },
        "totalSpent": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerId", "authorizedUsers"]
    },
    "MnemeItem": {
      "title": "Mneme Item",
      "description": "An item belonging to a smart shopping list",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "listId": { "type": "string" },
        "name": { "type": "string" },
        "quantity": { "type": "string" },
        "category": { "type": "string" },
        "isCompleted": { "type": "boolean" },
        "price": { "type": "number" },
        "addedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["listId", "name", "isCompleted", "addedBy"]
    }
  },
  "firestore": {
    "users/{uid}": {
      "schema": "User",
      "description": "User profiles"
    },
    "services/{serviceId}": {
      "schema": "ServiceAnnouncement",
      "description": "City services directory"
    },
    "blog_posts/{postId}": {
      "schema": "BlogPost",
      "description": "Editorial content and news"
    },
    "associations/{assocId}": {
      "schema": "Association",
      "description": "Professional associations"
    },
    "associations/{assocId}/members/{memberId}": {
      "schema": {
        "title": "Association Member",
        "type": "object",
        "properties": {
          "uid": { "type": "string" },
          "role": { "type": "string" },
          "joinedAt": { "type": "string", "format": "date-time" },
          "status": { "type": "string" }
        }
      },
      "description": "Members belonging to an association"
    },
    "patrons/{patronId}": {
      "schema": "Patron",
      "description": "Verified businesses"
    },
    "alerts/{alertId}": {
      "schema": "Alert",
      "description": "Road alerts"
    },
    "classifieds/{adId}": {
      "schema": "Classified",
      "description": "Marketplace ads"
    },
    "loyalty_transactions/{txId}": {
      "schema": {
        "title": "Loyalty Transaction",
        "type": "object",
        "properties": {
          "userId": { "type": "string" },
          "patronId": { "type": "string" },
          "weights": { "type": "object" },
          "status": { "type": "string" },
          "kmEarned": { "type": "number" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "description": "Telemetry and conversion logs for loyalty"
    },
    "config_plans/{planId}": {
      "schema": {
        "title": "Association Plan",
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "base_price": { "type": "number" },
          "cycle": { "type": "string" }
        }
      },
      "description": "System configuration for plans and associations"
    },
    "mneme_lists/{listId}": {
      "schema": "MnemeList",
      "description": "Smart shopping lists representing family groceries/supplies"
    },
    "mneme_items/{itemId}": {
      "schema": "MnemeItem",
      "description": "Items in smart shopping lists"
    }
  }
}
